{
  "name": "notekori",
  "version": "1.0.0",
  "private": true,
  "description": "NoteKori - Cloud-based Personal Finance Tracker",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w web",
    "deploy:web": "npm run build -w web && npm run deploy -w web",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "keywords": [
    "finance",
    "expense-tracker",
    "personal-finance",
    "nextjs",
    "cloudflare"
  ],
  "author": "Saikat",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
